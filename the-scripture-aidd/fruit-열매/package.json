{
  "name": "spiritual-warfare-tetris",
  "version": "1.0.0",
  "private": true,
  "description": "영적 전쟁 테트리스 — KJV 기반 실시간 2인 대전 테트리스 (TASK-001, REQ-016, FR-073, D-29 재각 R1)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --port 8787 --ip 127.0.0.1",
    "dev:client": "vite --config client/vite.config.js --port 5173 --strictPort",
    "build": "npm run build:client && npm run build:worker",
    "build:client": "vite build --config client/vite.config.js",
    "build:worker": "wrangler deploy --dry-run --config worker/wrangler.toml --outdir worker/dist",
    "typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "types:worker": "wrangler types --config worker/wrangler.toml --include-env=false worker/worker-configuration.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:content": "node scripts/check-content.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "canvas-confetti": "1.9.4",
    "gsap": "3.15.0",
    "partysocket": "1.3.0",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.22.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "4.147.0"
  }
}
